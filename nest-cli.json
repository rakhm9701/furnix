{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/furnix/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/furnix/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/furnix",
  "projects": {
    "furnix": {
      "type": "application",
      "root": "apps/furnix",
      "entryFile": "main",
      "sourceRoot": "apps/furnix/src",
      "compilerOptions": {
        "tsConfigPath": "apps/furnix/tsconfig.app.json"
      }
    },
    "furnix-batch": {
      "type": "application",
      "root": "apps/furnix-batch",
      "entryFile": "main",
      "sourceRoot": "apps/furnix-batch/src",
      "compilerOptions": {
        "tsConfigPath": "apps/furnix-batch/tsconfig.app.json"
      }
    }
  }
}